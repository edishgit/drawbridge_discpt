flowchart TD
    %% ==========================================
    %% PROFESSIONAL ENTERPRISE COLOR PALETTE
    %% ==========================================
    classDef untrusted fill:#FCE8E6,stroke:#C5221F,stroke-width:2px,color:#202124
    classDef screening fill:#FEF7E0,stroke:#F29900,stroke-width:2px,color:#202124
    classDef memory fill:#E6F4EA,stroke:#1E8E3E,stroke-width:2px,color:#202124
    classDef model fill:#F3E8FD,stroke:#9334E6,stroke-width:2px,color:#202124
    classDef runtime fill:#E8F0FE,stroke:#1A73E8,stroke-width:2px,color:#202124
    classDef gates fill:#FCE8E6,stroke:#D93025,stroke-width:2px,color:#202124
    classDef gov fill:#F8F9FA,stroke:#BCC1C6,stroke-width:2px,color:#202124
    classDef backbone fill:#FFFFFF,stroke:#80868B,stroke-width:2px,color:#202124,stroke-dasharray: 5 5

    %% ==========================================
    %% ① UNTRUSTED ZONE
    %% ==========================================
    subgraph Z1 [① UNTRUSTED ZONE - every byte here was authored by the party being judged]
        direction TB
        VC["`**Vendor contact**
        NimbusWrite AI · Tier 1 · AI SaaS`"]:::untrusted
        VI["`**Vendor Inbox** (Cloud Run)
        simulated mail channel
        SMTP-adapter compatible`"]:::untrusted
        
        VC --> VI
    end

    %% ==========================================
    %% ② INGRESS SCREENING
    %% ==========================================
    subgraph Z2 [② INGRESS SCREENING - a platform-owned pipeline; no agent has a code path into quarantine]
        direction TB
        QDB[("`**evidence-quarantine**
        Cloud Storage (raw bytes)
        7-day lifecycle rule`")]:::screening
        Ext["`**Local extraction**
        text pulled without
        model contact`"]:::screening
        Arm{"`**Model Armor**
        five filters · two templates
        fail-closed on a skipped detector`"}:::screening
        Inert[("`**Inert excerpt**
        blocked payload kept as
        evidence · never re-prompted`")]:::screening
        Clean[("`**evidence-clean**
        signed verdict bearing stamp
        template · version · per-filter verdicts`")]:::screening

        QDB --> Ext
        Ext -- "screen FIRST, on real text" --> Arm
        Arm -- "threat found - blocked" --> Inert
        Arm -- "clean or sanitized" --> Clean
    end

    VI -- "evidence uploads and reply bodies alike" --> QDB

    %% ==========================================
    %% ③ EVENT BACKBONE
    %% ==========================================
    subgraph Z3 [③ EVENT BACKBONE - Pub/Sub at-least-once, unordered]
        Evt["`**Message Bus**
        DLQ after 5 attempts ➔ NEEDS_HUMAN
        ---
        review.intake · review.plan_ready · review.chase_due
        vendor.reply_received · vendor.evidence_uploaded · evidence.screened
        review.findings_ready · review.score_ready · review.approved
        review.rescore · watchdog.sweep · watchdog.hit`"]:::backbone
    end

    Inert -- "ADVERSARIAL CONDUCT\n-25 trust points (forced escalation)" --> Evt
    Clean -- "evidence.screened" --> Evt

    %% ==========================================
    %% ④ AGENT RUNTIME
    %% ==========================================
    subgraph Z4 [④ AGENT RUNTIME - ADK 2 agents on Vertex AI Agent Engine - orchestrated by Pub/Sub, not by a graph runner - one identity each]
        direction LR
        Quest["`**Questionnaire**
        sa-questionnaire
        generate · send · parse · chase`"]:::runtime
        Risk["`**Risk Scorer**
        sa-scorer
        rubric arithmetic · memo`"]:::runtime
        Watch["`**Watchdog**
        sa-watchdog
        scheduled post-approval sweeps`"]:::runtime
        Evid["`**Evidence**
        sa-evidence
        extract · retrieve · cross-examine`"]:::runtime
        Orch["`**Orchestrator**
        sa-orchestrator
        tier · plan · re-tier · dispatch · gate`"]:::runtime
    end

    Evt --> Quest & Risk & Watch & Evid & Orch

    %% ==========================================
    %% ⑤ TOOL & MODEL PLANE
    %% ==========================================
    subgraph Z5 [⑤ TOOL & MODEL PLANE - P1 and P2 at the gateway, P3 in the router — the only place every model call passes]
        direction TB
        P1["`**P1**
        no outbound email to a new contact
        without a signed human approval token
        verified with a public key it cannot sign with`"]:::model
        P2["`**P2**
        no external content reaches a model
        without a verified verdict-bearing clean stamp`"]:::model
        P3["`**P3**
        no outbound fetch outside
        the fixed allowlist`"]:::model
        GemFlash["`**Gemini 1.5 Flash** (default)
        parse · extract · classify`"]:::model
        GemPro["`**Gemini 1.5 Pro** (exactly two places)
        cross-examination · risk memo`"]:::model
        OutScreen["`**Output screening**
        drawbridge-output-template
        memo and outbound mail checked
        before a human acts on them`"]:::model
        GemEmb["`**gemini-embedding-001** (3072 dim)
        evidence chunks - called by the Evidence agent,
        never by the screening identity`"]:::model

        P2 --> GemFlash & GemPro
        GemPro --> OutScreen
    end

    Evid --> GemEmb

    %% ==========================================
    %% ⑥ STATE & MEMORY
    %% ==========================================
    subgraph Z6 [⑥ STATE & MEMORY - four layers, four jobs]
        direction TB
        L25[("`**L2.5 - Semantic retrieval**
        Pinecone kNN over screened evidence
        *which passage says this?*`")]:::memory
        L1[("`**L1 - Session state**
        Agent Engine
        in-flight reasoning`")]:::memory
        L2[("`**L2 - Firestore ledger**
        reviews · findings · events
        checkpoints · idempotency keys`")]:::memory
        L3[("`**L3 - Memory Bank**
        vendor dossiers · policy memory
        structured notes only - provenance-tagged`")]:::memory
    end

    GemEmb -- "chunk · embed · index\nonly stamped content" --> L25
    L25 -- "top-k passages per claim" --> GemPro

    %% ==========================================
    %% ⑦ HUMAN GATES
    %% ==========================================
    subgraph Z7 [⑦ HUMAN GATES - signed, single-use, scoped tokens — enforced at the gateway, never in the UI]
        direction TB
        Dash["`**Internal Dashboard** (Cloud Run)
        queue · review timeline · gate card
        read-only: no signing key, no write path`"]:::gates
        G2["`**G2 - First outbound contact**
        Priya, Security Analyst
        the human act that P1 makes unskippable`"]:::gates
        G1["`**G1 - Risk acceptance**
        Elena, CISO`"]:::gates

        Dash --> G2 & G1
    end

    OutScreen --> Dash
    G2 -- "authorised send - exactly once" --> P1
    P1 --> VI
    G1 -- "no DECIDED state\nwithout a named human" --> Orch

    %% ==========================================
    %% ⑧ GOVERNANCE & OBSERVABILITY
    %% ==========================================
    subgraph Z8 [⑧ GOVERNANCE & OBSERVABILITY - the audit trail is the deliverable]
        direction TB
        Trace["`**Cloud Trace / Logging**
        OTel span per step: goal · decision · model · latency · cost
        refs, hashes and verdicts only — never raw external content`"]:::gov
        Bind["`**Audit Binder** (Cloud Run)
        8 sections ➔ binders bucket ➔ template-rendered
        never model-written
        SOC 2 CC9.2 · ISO 27001 A.5.19–5.23 · DORA`"]:::gov
        IAM["`**IAM** - 10 least-privilege identities
        collection-level rows generated into Firestore rules
        230 rows asserted against a running emulator`"]:::gov

        Trace --> Bind
    end

    L1 --> Trace
    L2 --> Trace
    L3 --> Trace
    L2 --> Bind
    L3 --> Bind
