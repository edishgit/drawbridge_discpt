---
title: "Drawbridge — Firestore data model"
---
erDiagram
  VENDOR ||--o{ REVIEW : "is reviewed by"
  VENDOR ||--o| DOSSIER : "remembered as"
  VENDOR ||--o{ WATCHDOG_TASK : "monitored by"
  REVIEW ||--o{ EVENT : records
  REVIEW ||--o{ QA_RESPONSE : collects
  REVIEW ||--o{ SCREENING : screens
  REVIEW ||--o{ FINDING : produces
  REVIEW ||--|| SCORE : yields
  REVIEW ||--o| APPROVAL : "gated by"
  REVIEW ||--o{ IDEMPOTENCY_KEY : guards
  REVIEW ||--o{ SPAN : traces
  REVIEW ||--o| BINDER : exports
  REVIEW ||--o| REVIEW : "reopened as"
  SCREENING ||--o| FINDING : "may raise conduct"

  VENDOR {
    string vendor_id PK
    string name
    string category
    boolean is_ai_vendor "auto-adds the AI domain"
    int tier "1 critical, 2 internal, 3 light"
    boolean adversarial_flag "carried into every future review"
    string status
  }
  REVIEW {
    string review_id PK
    string vendor_id FK
    string state "INTAKE to MONITORED or NEEDS_HUMAN"
    string current_step
    array completed_steps "resume replays and skips these"
    map step_results
    int score
    string band
    float cost_usd "accumulated model spend"
    datetime opened_at
    datetime decided_at
    string reopened_from FK "history is never mutated"
  }
  EVENT {
    string event_id PK
    string type "the topic name"
    string idem_key
    string trace_id "ties the event to its span tree"
    string source
    datetime ts
    map payload
  }
  QA_RESPONSE {
    string question_id PK
    string domain
    text answer
    float confidence "below threshold sets needs_human"
    string source_msg "parse provenance for the binder"
  }
  SCREENING {
    string screening_id PK
    string object_ref
    boolean clean
    array categories "injection, poisoning, PII"
    text matched_excerpt "inert evidence, never re-prompted"
    string clean_stamp
    datetime ts
  }
  FINDING {
    string finding_id PK
    string domain
    string severity "low, medium, high"
    boolean contradiction "needs a claim AND a contradicting passage"
    text summary
    string evidence_ref
    string claim_ref
    string trace_ref
  }
  SCORE {
    int raw "0 to 100"
    map breakdown "per domain arithmetic, shown in the binder"
    boolean adversarial_conduct
    int adversarial_penalty "minus 25"
    string band
  }
  APPROVAL {
    string approval_id PK
    string identity "named human, never an agent"
    string decision "approve, conditional, reject"
    text conditions
    string jti "single-use token id"
    datetime ts
  }
  IDEMPOTENCY_KEY {
    string idem_key PK "review_id and step_id"
    string status "in_progress or done"
    string source
    map result
    datetime done_ts
  }
  SPAN {
    string span_id PK
    string agent
    text goal "plain English, so the binder reads like prose"
    text decision
    string model
    int tokens
    float cost_usd
    int latency_ms
  }
  DOSSIER {
    string vendor_id PK
    array prior_reviews
    array negotiated_exceptions
    array policy_notes
    string contact_persona
  }
  WATCHDOG_TASK {
    string task_id PK
    string signal
    string source_feed
    datetime detected_at
    string opened_review FK
  }
  BINDER {
    string binder_id PK
    string storage_ref
    array frameworks "SOC 2, ISO 27001, DORA"
    datetime generated_at
  }
