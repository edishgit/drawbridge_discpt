---
title: "Drawbridge — System Architecture: trust zones, the fleet, and the governance plane"
---
flowchart TB

  subgraph Z1["① UNTRUSTED ZONE · every byte here was authored by the party being judged"]
    direction LR
    VC["<b>Vendor contact</b><br/>NimbusWrite AI · Tier 1 · AI SaaS"]
    PORTAL["<b>Vendor Portal</b> · Cloud Run<br/>token-scoped link · questionnaire<br/>form · evidence dropzone"]
    MAILBOX["<b>Vendor Inbox</b> · Cloud Run<br/>simulated mail channel<br/>SMTP-adapter compatible"]
  end

  subgraph Z2["② INGRESS SCREENING · a platform-owned pipeline; no agent has a code path into quarantine"]
    direction LR
    QB[("<b>evidence-quarantine</b><br/>Cloud Storage · raw bytes")]
    EXT["<b>Local extraction</b><br/>text pulled without<br/>model contact"]
    GEMMA["<b>Gemma 3 scrubber</b><br/>Cloud Run · in-VPC<br/>PII → typed placeholders"]
    ARMOR{"<b>Model Armor</b><br/>injection · poisoning · PII"}
    CB[("<b>evidence-clean</b><br/>signed clean-stamp")]
    INERT[("<b>Inert excerpt</b><br/>blocked payload kept as<br/>evidence · never re-prompted")]
  end

  subgraph Z3["③ EVENT BACKBONE · Pub/Sub · at-least-once delivery · DLQ after 5 attempts → NEEDS_HUMAN"]
    direction LR
    TOPICS["review.intake · review.plan_ready · vendor.reply_received · vendor.evidence_uploaded<br/>evidence.screened · review.findings_ready · review.score_ready · review.approved · watchdog.hit"]
  end

  subgraph Z4["④ AGENT RUNTIME · Vertex AI Agent Engine · ADK Python · one service-account identity per agent"]
    direction LR
    ORC["<b>Orchestrator</b><br/>sa-orchestrator<br/>tier · plan · dispatch · gate"]
    QA["<b>Questionnaire</b><br/>sa-questionnaire<br/>generate · send · parse · chase"]
    EV["<b>Evidence</b><br/>sa-evidence<br/>extract · cross-examine"]
    RS["<b>Risk Scorer</b><br/>sa-scorer<br/>rubric arithmetic · memo"]
    WD["<b>Watchdog</b><br/>sa-watchdog<br/>scheduled post-approval sweeps"]
  end

  subgraph Z5["⑤ TOOL &amp; MODEL PLANE · Agent Gateway is the only exit"]
    direction LR
    P1{{"<b>P1</b> · no outbound email to a new contact<br/>without a signed human approval token"}}
    P2{{"<b>P2</b> · no external content reaches a model<br/>without a verified clean-stamp"}}
    FLASH["<b>Gemini 3.5 Flash</b> · default<br/>parse · extract · score · chase"]
    PRO["<b>Gemini Pro</b> · sparingly<br/>cross-examination · risk memo"]
  end

  subgraph Z6["⑥ STATE &amp; MEMORY · three layers, three jobs"]
    direction LR
    L1["<b>L1 · Session state</b><br/>Agent Engine<br/>in-flight reasoning"]
    L2[("<b>L2 · Firestore ledger</b><br/>reviews · findings · events<br/>checkpoints · idempotency keys")]
    L3[("<b>L3 · Memory Bank</b><br/>vendor dossiers · policy memory<br/>adversarial flag carried forward")]
  end

  subgraph Z7["⑦ HUMAN GATES · signed, single-use, scoped tokens — enforced at the gateway, never in the UI"]
    direction LR
    DASH["<b>Internal Dashboard</b> · Cloud Run<br/>queue · review timeline · gate card · fleet status strip"]
    G1["<b>G1 · Risk acceptance</b><br/>Elena, CISO"]
    G2["<b>P1 · First outbound contact</b><br/>Priya, Security Analyst"]
  end

  subgraph Z8["⑧ GOVERNANCE &amp; OBSERVABILITY · the audit trail is the deliverable"]
    direction LR
    OTEL["<b>Cloud Trace / Logging</b><br/>OTel span per step:<br/>goal · decision · model · latency · cost"]
    BINDER["<b>Audit Binder</b> · Cloud Run<br/>8 sections → binders bucket<br/>SOC 2 CC9.2 · ISO 27001 A.5.19–5.23 · DORA"]
    REG["<b>Agent Registry</b><br/>Vendor Review Fleet v1.2<br/>published · versioned · discoverable"]
    IAM["<b>IAM</b> · 5 least-privilege identities<br/>denied actions asserted by tests"]
  end

  VC --> PORTAL
  VC --> MAILBOX
  PORTAL -- "evidence upload" --> QB
  MAILBOX -- "reply bodies are untrusted too" --> QB
  QB --> EXT --> GEMMA --> ARMOR
  ARMOR -- "clean" --> CB
  ARMOR -- "threat found · blocked" --> INERT
  CB -- "evidence.screened" --> TOPICS
  INERT == "ADVERSARIAL CONDUCT · −25 · forced escalation" ==> TOPICS

  TOPICS --> ORC
  TOPICS --> QA
  TOPICS --> EV
  TOPICS --> RS
  TOPICS --> WD

  QA --> P1
  EV --> P2
  RS --> P2
  P2 --> FLASH
  P2 --> PRO
  ORC --> L1
  ORC --> L2
  ORC --> L3

  L2 --> DASH
  DASH --> G1
  DASH --> G2
  L2 --> OTEL
  L2 --> BINDER
  OTEL --> BINDER

  P1 -. "authorised send · exactly-once" .-> MAILBOX
  G1 -. "no DECIDED state without a named human" .-> ORC

